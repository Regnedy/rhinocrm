APP_NAME="Rhino CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.example.com
APP_TIMEZONE=America/Mazatlan
APP_LOCALE=es
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rhino_crm
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
SESSION_DRIVER=database
FILESYSTEM_DISK=local

# Inicio de sesión disponible ahora: local. Firebase se habilita después.
RHINO_AUTH_DRIVER=local
RHINO_SESSION_DAYS=30
RHINO_SESSION_TOUCH_SECONDS=300
RHINO_REPORT_DISK=local
RHINO_INSTALLER_ENABLED=true

RHINO_VERSION=2026.08.08-whatsapp-embedded-signup.1
RHINO_DEV_CONSOLE_ENABLED=true
RHINO_DEV_CONSOLE_ALLOWED_IPS=
RHINO_DEV_CONSOLE_REDACT_PII=true
RHINO_DEV_CONSOLE_MAX_LOG_LINES=1000
RHINO_DEV_CONSOLE_MAX_LOG_BYTES=2097152
RHINO_DEV_CONSOLE_MAX_SOURCE_FILE_BYTES=131072
RHINO_DEV_CONSOLE_MAX_SOURCE_FILES=8
RHINO_DEV_CONSOLE_REAUTH_MINUTES=10
RHINO_DEV_CONSOLE_AI_ENABLED=false
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_MAX_CONTEXT_CHARS=90000

# Firebase Authentication es opcional y no utiliza Firestore.
# Para transición segura: RHINO_AUTH_DRIVER=hybrid.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/private/firebase/firebase-admin.json
FIREBASE_REQUIRE_EMAIL_VERIFIED=true
FIREBASE_AUTO_LINK_BY_EMAIL=true
FIREBASE_CHECK_REVOKED_TOKENS=true
FIREBASE_ALLOW_DIRECT_API_TOKENS=false
FIREBASE_SYNC_CUSTOM_CLAIMS_ON_LOGIN=true

FIREBASE_AUTO_SEND_VERIFICATION=true
FIREBASE_VERIFICATION_CONTINUE_URL=${APP_URL}
FIREBASE_EMULATOR_ENABLED=false
FIREBASE_AUTH_EMULATOR_HOST=

META_WHATSAPP_API_URL=https://graph.facebook.com/v25.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_EMBEDDED_SIGNUP_ENABLED=false

CONTACT_ID_HASH_KEY=
IOT_REPLAY_WINDOW_SECONDS=300
IOT_MAX_REQUESTS_PER_MINUTE=10
IOT_MAX_REQUESTS_PER_IP_PER_MINUTE=60
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_LOCK_SECONDS=300

# Informes personalizados por evento y WhatsApp
RHINO_PERSONAL_REPORT_DISK=local
RHINO_PERSONAL_REPORT_DIRECTORY=personal-reports
RHINO_PERSONAL_REPORT_ALGORITHM=rhino-nutrition-engine-v1
RHINO_NUTRITION_ALGORITHM=rhino-nutrition-engine-v1
# Número oficial de WhatsApp con código de país, solo dígitos. Ejemplo México: 521...
RHINO_WHATSAPP_BUSINESS_PHONE=
RHINO_WHATSAPP_CONTACT_NAME=RHINO CRM
RHINO_WHATSAPP_WINDOW_HOURS=24
# Plantilla aprobada con encabezado DOCUMENT para enviar fuera de la ventana de servicio.
RHINO_WHATSAPP_REPORT_TEMPLATE=
RHINO_WHATSAPP_REPORT_TEMPLATE_LANGUAGE=es_MX
RHINO_PERSONAL_REPORT_DISCLAIMER="Las mediciones y la alimentación recomendada son orientativas. No constituyen diagnóstico ni prescripción clínica y no sustituyen consulta médica o nutricional profesional."

# Campañas de seguimiento nutricional
RHINO_NUTRITION_CAMPAIGN_DAYS_SINCE_PLAN=30
RHINO_WHATSAPP_NUTRITION_INVITATION_TEMPLATE=
RHINO_WHATSAPP_NUTRITION_INVITATION_LANGUAGE=es_MX


# Motor alimentario autónomo
RHINO_NUTRITION_LIBRARY_VERSION=2026.07.22-engine-v1
RHINO_NUTRITION_DEFAULT_MEALS_PER_DAY=4
# MANUAL_JSON genera prompts y valida el JSON pegado; los planes no dependen de IA.
RHINO_NUTRITION_AI_MODE=MANUAL_JSON
# Región y telefonía
RHINO_DEFAULT_COUNTRY_ISO=MX
RHINO_DEFAULT_COUNTRY_DIAL_CODE=52

# PDF y WhatsApp de planes alimenticios
RHINO_NUTRITION_PDF_DISK=local
RHINO_NUTRITION_PDF_DIRECTORY=nutrition-plans
RHINO_WHATSAPP_NUTRITION_PLAN_TEMPLATE=
RHINO_WHATSAPP_NUTRITION_PLAN_LANGUAGE=es_MX
RHINO_WHATSAPP_NUTRITION_IMAGES_TEMPLATE=
RHINO_WHATSAPP_NUTRITION_IMAGES_LANGUAGE=es_MX


# Rhino CRM mobile app and billing foundation (disabled by default)
BILLING_ENABLED=false
SUBSCRIPTION_ENFORCEMENT_ENABLED=false
BILLING_DEFAULT_PLAN_CODE=rhino_crm_access
BILLING_GRACE_DAYS=3
STRIPE_BILLING_ENABLED=false
GOOGLE_PLAY_BILLING_ENABLED=false
APPLE_BILLING_ENABLED=false
RHINO_MOBILE_MIN_VERSION=1.0.0
RHINO_MOBILE_LATEST_VERSION=1.0.0
RHINO_MOBILE_MAINTENANCE=false
RHINO_MOBILE_SUPPORT_EMAIL=soporte@rhinocrm.app
